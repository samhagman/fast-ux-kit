{
  "name": "@samhagman/fast-ux-kit",
  "version": "0.2.0",
  "private": false,
  "description": "Reusable React UX layer, rich outliner and extensible text intelligence",
  "type": "module",
  "license": "LicenseRef-PolyForm-Noncommercial-1.0.0 OR LicenseRef-PolyForm-Small-Business-1.0.0",
  "files": [
    "dist",
    "README.md",
    "LICENSE.md",
    "CONTRIBUTING.md",
    "NOTICE.md",
    "THIRD_PARTY_NOTICES.md",
    "docs"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./styles.css": "./dist/library.css",
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./components.css": "./dist/library.css",
    "./tokens.css": "./dist/tokens.css",
    "./rich": {
      "types": "./dist/rich/index.d.ts",
      "import": "./dist/rich/index.js"
    },
    "./machine": {
      "types": "./dist/core/machine/index.d.ts",
      "import": "./dist/core/machine/index.js"
    },
    "./machine.css": "./dist/library.css",
    "./machine-tree.css": "./dist/library.css",
    "./outliner": {
      "types": "./dist/outliner/index.d.ts",
      "import": "./dist/outliner/index.js"
    },
    "./outliner.css": "./dist/library.css",
    "./machine-view": {
      "types": "./dist/machine-view/index.d.ts",
      "import": "./dist/machine-view/index.js"
    },
    "./machine-view.css": "./dist/library.css",
    "./machine-tree": {
      "types": "./dist/machine-tree/index.d.ts",
      "import": "./dist/machine-tree/index.js"
    },
    "./components/ui/*": {
      "types": "./dist/components/ui/*.d.ts",
      "import": "./dist/components/ui/*.js"
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "node scripts/build-library.mjs",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts tests/*.test.tsx tests/*.test.mjs",
    "check": "npm run typecheck && npm run format:check && npm test && npm run build",
    "test:consumer": "node scripts/test-consumer.mjs",
    "demo:build": "npm run docs:build",
    "format": "prettier --write src tests scripts docs studio/src studio/tests studio/*.json studio/*.ts studio/*.md *.json *.md",
    "format:check": "prettier --check src tests scripts docs studio/src studio/tests studio/*.json studio/*.ts studio/*.md *.json *.md",
    "test:browser": "node scripts/test-browser.mjs",
    "docs:build": "npm run build && npm --prefix studio run build",
    "dev": "npm --prefix studio run dev"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@testing-library/react": "16.3.0",
    "@types/culori": "^4.0.1",
    "@types/jsdom": "21.1.7",
    "@types/katex": "^0.16.8",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.25.12",
    "jsdom": "26.1.0",
    "prettier": "3.9.10",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@internationalized/date": "3.12.4",
    "@tanstack/react-virtual": "3.14.24",
    "@xyflow/react": "12.12.0",
    "@xyflow/system": "0.0.83",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "culori": "4.0.2",
    "date-fns": "4.4.0",
    "elkjs": "0.12.1",
    "katex": "0.16.47",
    "lucide-react": "1.64.0",
    "micromark": "4.0.3",
    "micromark-extension-gfm-strikethrough": "2.1.0",
    "motion": "14.8.0",
    "prosemirror-commands": "1.7.2",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-model": "1.25.12",
    "prosemirror-state": "1.4.4",
    "prosemirror-transform": "1.12.4",
    "prosemirror-view": "1.42.9",
    "react-day-picker": "10.0.2",
    "react-easy-crop": "6.2.4",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "4.15.2",
    "remark-gfm": "4.0.1",
    "signature_pad": "5.1.4",
    "tailwind-merge": "3.7.0",
    "uqr": "0.1.3"
  },
  "workspaces": [
    "studio"
  ],
  "author": "Sam Hagman",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samhagman/fast-ux-kit.git"
  },
  "homepage": "https://github.com/samhagman/fast-ux-kit#readme",
  "bugs": {
    "url": "https://github.com/samhagman/fast-ux-kit/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
